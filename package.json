{
  "name": "extensions-cross_browser-sync",
  "version": "1.0.1",
  "description": "Cross-browser WebExtension to sync installed extensions and their enabled/disabled state across Chromium browsers (Chrome, Edge, Brave, Vivaldi, Opera) and Firefox via GitHub Gist.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "download:xpi": "node scripts/download-xpi.mjs",
    "update:catalog": "node scripts/update-catalog.mjs",
    "update:catalog:xpi": "node scripts/update-catalog-xpi-paths.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "browser-extension",
    "webextension",
    "sync",
    "chrome",
    "firefox",
    "edge",
    "brave",
    "github-gist",
    "manifest-v3"
  ],
  "license": "MIT"
}

